        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "let userProfile = pm.response.json();",
              "",
              "pm.test(\"Status code is 200 - Perfil obtenido correctamente\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"El perfil corresponde al usuario 'emilys'\", function () {",
              "    pm.expect(userProfile.username).to.eql(\"emilys\");",
              "});",
              "",
              "pm.test(\"El usuario tiene id, email y datos completos\", function () {",
              "    pm.expect(userProfile).to.have.property(\"id\");",
              "    pm.expect(userProfile).to.have.property(\"email\");",
              "    pm.expect(userProfile.email).to.include(\"@\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
